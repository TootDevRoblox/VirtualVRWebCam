{
  "name": "camvr-webcam-driver",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Rastreamento de cabeca e maos por webcam com driver virtual OpenVR",
  "main": "electron/main.cjs",
  "scripts": {
    "start": "concurrently -k -s first \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && electron .\"",
    "build": "vite build",
    "build:driver": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-driver.ps1",
    "install:driver": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/install-driver.ps1",
    "uninstall:driver": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/uninstall-driver.ps1"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "1.1.0"
  },
  "devDependencies": {
    "concurrently": "9.2.5",
    "electron": "44.7.0",
    "vite": "8.3.4",
    "wait-on": "8.0.4"
  }
}
